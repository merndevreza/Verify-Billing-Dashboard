# Backend base URL (staging: https://api.verify.barikoimaps.dev, production: https://api.verify.bmapsbd.com)
NEXT_PUBLIC_API_BASE_URL=https://api.verify.barikoimaps.dev

# NextAuth JWT signing secret (Auth.js v5 also accepts AUTH_SECRET)
NEXTAUTH_SECRET=

# Self-hosted GraphHopper routing server (graphhopper-bd project, docker compose up)
GRAPHHOPPER_URL=http://localhost:8989

# Barikoi API key
BARIKOI_API_KEY=
